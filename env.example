# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ===========================================
# 交易所 API 配置
# ===========================================
# Binance API 密钥（生产模式必需）
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# ===========================================
# 消息推送配置
# ===========================================
# Telegram 推送
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 飞书/Lark 推送
LARK_TOKEN=your_lark_webhook_token_here
FEISHU_TOKEN=your_feishu_webhook_token_here

# 微信推送（Server酱）
WEIXIN_FT_TOKEN=your_weixin_send_key_here

# ===========================================
# 网络代理配置（可选）
# ===========================================
# 如果在中国大陆使用，建议设置代理
HTTPS_PROXY=http://127.0.0.1:7890
HTTP_PROXY=http://127.0.0.1:7890

# ===========================================
# 其他配置（可选）
# ===========================================
# 日志级别
LOG_LEVEL=info

# 调试模式（true/false）
DEBUG=false
